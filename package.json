{
  "name": "mini-fts",
  "version": "0.1.0",
  "description": "Local full-text search: tokenizer, inverted index, BM25, file watcher, HTTP API",
  "type": "module",
  "bin": { "minifts": "./src/cli.js" },
  "main": "./src/index.js",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "scripts": {
    "index": "node src/cli.js index ./corpus",
    "search": "node src/cli.js search",
    "serve": "node src/server.js",
    "test": "node --test test/search.test.mjs"
  }
}
